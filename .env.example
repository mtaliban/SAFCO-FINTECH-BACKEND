###########################################
# SAFCO FINTECH LMS - Environment Config
###########################################

# APPLICATION
APP_NAME="SAFCO FINTECH LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# API
API_VERSION=v1
API_PREFIX=api
FRONTEND_URL=http://localhost:3000

# LOGGING
LOG_CHANNEL=stack
LOG_LEVEL=debug
LOG_STACK=daily

###########################################
# DATABASE - MySQL
###########################################
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=safco_lms
DB_USERNAME=safco_user
DB_PASSWORD=safco_secret_2026

###########################################
# CACHE & SESSIONS - Redis
###########################################
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

###########################################
# QUEUE - Redis Backed
###########################################
QUEUE_CONNECTION=redis
HORIZON_PREFIX=safco_horizon

###########################################
# BROADCAST - Laravel Reverb (WebSockets)
###########################################
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=safco-lms
REVERB_APP_KEY=safco_reverb_key
REVERB_APP_SECRET=safco_reverb_secret
REVERB_HOST=0.0.0.0
REVERB_PORT=8080
REVERB_SCHEME=http

###########################################
# EVENT DRIVEN - RabbitMQ (Internal Broker)
###########################################
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=safco_rabbit
RABBITMQ_PASSWORD=safco_rabbit_secret
RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=safco.events
RABBITMQ_EXCHANGE_TYPE=topic

###########################################
# MQTT - HiveMQ (Real-Time for Mobile/IoT)
###########################################
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USERNAME=safco_mqtt
MQTT_PASSWORD=safco_mqtt_secret
MQTT_CLIENT_ID=safco_lms_backend
MQTT_KEEP_ALIVE=60
MQTT_CLEAN_SESSION=true
MQTT_TLS_ENABLED=false
MQTT_TOPIC_PREFIX=safco/lms

###########################################
# ELASTICSEARCH (Search + Logs)
###########################################
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_SCHEME=http
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=
SCOUT_DRIVER=elastic

###########################################
# MAIL
###########################################
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@safcofintech.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

###########################################
# SMS - Africa's Talking (Tanzania)
###########################################
AT_USERNAME=safco_fintech
AT_API_KEY=
AT_SENDER_ID=SAFCO
AT_ENVIRONMENT=sandbox

###########################################
# SOCIAL AUTH
###########################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/api/v1/auth/social/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=${APP_URL}/api/v1/auth/social/microsoft/callback
MICROSOFT_TENANT_ID=common

###########################################
# FILE STORAGE
###########################################
FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=safco-lms-storage
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=fra1
DO_SPACES_BUCKET=safco-lms-backup
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

###########################################
# SANCTUM (JWT-like Auth Tokens)
###########################################
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SESSION_DOMAIN=localhost
SANCTUM_EXPIRATION=1440

###########################################
# TWO-FACTOR AUTHENTICATION
###########################################
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
GOOGLE_2FA_ISSUER="SAFCO FINTECH LMS"

###########################################
# MONITORING & OBSERVABILITY
###########################################
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

PROMETHEUS_ENABLED=true
PROMETHEUS_NAMESPACE=safco_lms

GRAFANA_URL=http://grafana:3000
KIBANA_URL=http://kibana:5601

###########################################
# ANALYTICS & LOGGING
###########################################
ACTIVITY_LOG_ENABLED=true
CSV_LOG_EXPORT_ENABLED=true
CSV_LOG_EXPORT_PATH=/var/www/html/storage/app/logs/csv

###########################################
# RATE LIMITING
###########################################
RATE_LIMIT_API=60
RATE_LIMIT_AUTH=5
RATE_LIMIT_OTP=3

###########################################
# CORS
###########################################
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.safcofintech.co.tz

# Module 10 — write-once signing key for certificate verification hashes
CERTIFICATE_SIGNING_KEY=
