{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "title": "SAFCO LMS - Overview",
  "tags": ["safco", "lms", "overview"],
  "timezone": "Africa/Dar_es_Salaam",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Users (last 5m)",
      "targets": [
        { "expr": "sum(rate(safco_lms_http_requests_total[5m]))", "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Registrations Today",
      "targets": [
        { "expr": "increase(safco_lms_user_registrations_total[24h])", "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed Logins (last 1h)",
      "targets": [
        { "expr": "increase(safco_lms_login_failures_total[1h])", "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events Published to Broker",
      "targets": [
        { "expr": "increase(safco_lms_events_published_total[1h])", "refId": "A" }
      ],
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP Request Duration (P95)",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(safco_lms_http_request_duration_seconds_bucket[5m]))",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Queue Depth by Queue",
      "targets": [
        { "expr": "safco_lms_queue_depth", "refId": "A", "legendFormat": "{{queue}}" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "MQTT Messages / sec (HiveMQ)",
      "targets": [
        { "expr": "rate(safco_lms_mqtt_published_total[1m])", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RabbitMQ Messages / sec",
      "targets": [
        { "expr": "rate(rabbitmq_channel_messages_published_total[1m])", "refId": "A" }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
    }
  ]
}
